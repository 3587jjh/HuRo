+# https://github.com/sczhou/ProPainter
+import os
+import cv2
+import numpy as np
+from tqdm import tqdm
+
+import torch
+
+from model.modules.flow_comp_raft import RAFT_bi
+from model.recurrent_flow_completion import RecurrentFlowCompleteNet
+from model.propainter import InpaintGenerator
+from core.utils import to_tensors
+from model.misc import get_device
+
+import warnings
+warnings.filterwarnings("ignore")
+
+pretrain_model_url = 'https://github.com/sczhou/ProPainter/releases/download/v0.1.0/'
+
+
+def get_ref_index(mid_neighbor_id, neighbor_ids, length, ref_stride=10, ref_num=-1):
+    ref_index = []
+    if ref_num == -1:
+        for i in range(0, length, ref_stride):
+            if i not in neighbor_ids:
+                ref_index.append(i)
+    else:
+        start_idx = max(0, mid_neighbor_id - ref_stride * (ref_num // 2))
+        end_idx = min(length, mid_neighbor_id + ref_stride * (ref_num // 2))
+        for i in range(start_idx, end_idx, ref_stride):
+            if i not in neighbor_ids:
+                if len(ref_index) > ref_num:
+                    break
+                ref_index.append(i)
+    return ref_index
+
+class ProPainterInference:
+    def __init__(self, model_dir='weights', device='cuda', raft_iter=20, fp16=True):
+        self.device = torch.device(device)
+        self.raft_iter = raft_iter
+        self.fp16 = fp16 and (self.device.type != 'cpu')  # fp16 needs a CUDA device
+        
+        # 1. Load Models
+        print(f"Loading ProPainter models from {model_dir}...")
+        
+        # RAFT
+        ckpt_path = os.path.join(model_dir, 'raft-things.pth')
+        self.fix_raft = RAFT_bi(ckpt_path, self.device)
+        
+        # Flow Completion
+        ckpt_path = os.path.join(model_dir, 'recurrent_flow_completion.pth')
+        self.fix_flow_complete = RecurrentFlowCompleteNet(ckpt_path)
+        for p in self.fix_flow_complete.parameters():
+            p.requires_grad = False
+        self.fix_flow_complete.to(self.device).eval()
+        
+        # ProPainter
+        ckpt_path = os.path.join(model_dir, 'ProPainter.pth')
+        self.model = InpaintGenerator(model_path=ckpt_path).to(self.device).eval()
+        
+        # cast once at init
+        if self.fp16:
+            self.fix_flow_complete = self.fix_flow_complete.half()
+            self.model = self.model.half()
+            
+        print("Models loaded successfully.")
+
+    def infer(self, frames_bgr, masks_bool, subvideo_length=80, neighbor_length=10, ref_stride=10):
+        """
+        frames_bgr: List of numpy arrays (H, W, 3) in BGR format
+        masks_bool: List of numpy arrays (H, W) in bool format
+        """
+        
+        # -----------------------------------------------------------
+        # 1. Preprocess: Numpy(BGR) -> Tensor (Directly) & Mask Dilation (OpenCV)
+        # -----------------------------------------------------------
+        
+        kernel_flow = cv2.getStructuringElement(cv2.MORPH_RECT, (17, 17))
+        kernel_inpaint = cv2.getStructuringElement(cv2.MORPH_RECT, (11, 11))
+        
+        frames_list = []
+        flow_masks_list = []
+        masks_dilated_list = []
+
+        for i in range(len(frames_bgr)):
+            # frame: BGR -> RGB -> tensor
+            # Normalize: (x / 255.0) * 2 - 1  ==> (x / 127.5) - 1
+            img_rgb = cv2.cvtColor(frames_bgr[i], cv2.COLOR_BGR2RGB)
+            img_tensor = torch.from_numpy(img_rgb).permute(2, 0, 1).float()
+            img_tensor = (img_tensor / 127.5) - 1.0
+            frames_list.append(img_tensor)
+            
+            m = masks_bool[i].astype(np.uint8) * 255
+            
+            m_flow = cv2.dilate(m, kernel_flow)
+            m_inpaint = cv2.dilate(m, kernel_inpaint)
+            
+            # Mask -> Tensor (0 or 1 float)
+            m_flow_tensor = torch.from_numpy(m_flow).unsqueeze(0).float() / 255.0
+            m_inpaint_tensor = torch.from_numpy(m_inpaint).unsqueeze(0).float() / 255.0
+            
+            flow_masks_list.append(m_flow_tensor)
+            masks_dilated_list.append(m_inpaint_tensor)
+
+        # Stack Tensors: List[Tensor] -> Tensor(1, T, C, H, W)
+        frames = torch.stack(frames_list, dim=0).unsqueeze(0)
+        flow_masks = torch.stack(flow_masks_list, dim=0).unsqueeze(0)
+        masks_dilated = torch.stack(masks_dilated_list, dim=0).unsqueeze(0)
+        
+        # Move to device
+        frames = frames.to(self.device)
+        flow_masks = flow_masks.to(self.device)
+        masks_dilated = masks_dilated.to(self.device)
+        
+        if self.fp16:
+            frames = frames.half()
+            flow_masks = flow_masks.half()
+            masks_dilated = masks_dilated.half()
+        
+        video_length = frames.size(1)
+        h, w = frames.shape[-2:]
+
+        with torch.no_grad():
+            # -------------------------------------------------------
+            # 2. Compute Flow (RAFT)
+            # -------------------------------------------------------
+            # [Original Logic] Determine chunk size based on width
+            if w <= 640: short_clip_len = 12
+            elif w <= 720: short_clip_len = 8
+            elif w <= 1280: short_clip_len = 4
+            else: short_clip_len = 2
+            
+            gt_flows_f_list, gt_flows_b_list = [], []
+            
+            for f in range(0, video_length, short_clip_len):
+                end_f = min(video_length, f + short_clip_len)
+                
+                # RAFT requires Float32 input even if model weights are loaded on device
+                # Ensure input chunk is float32
+                if f == 0:
+                    chunk = frames[:, f:end_f].float()
+                else:
+                    chunk = frames[:, f-1:end_f].float()
+
+                flows_f, flows_b = self.fix_raft(chunk, iters=self.raft_iter)
+                
+                gt_flows_f_list.append(flows_f)
+                gt_flows_b_list.append(flows_b)
+                torch.cuda.empty_cache()
+            
+            gt_flows_f = torch.cat(gt_flows_f_list, dim=1)
+            gt_flows_b = torch.cat(gt_flows_b_list, dim=1)
+            
+            # Convert flow back to fp16 if needed
+            if self.fp16:
+                gt_flows_bi = (gt_flows_f.half(), gt_flows_b.half())
+            else:
+                gt_flows_bi = (gt_flows_f, gt_flows_b)
+
+            # -------------------------------------------------------
+            # 3. Flow Completion
+            # -------------------------------------------------------
+            if video_length > subvideo_length:
+                pred_flows_f, pred_flows_b = [], []
+                pad_len = 5
+                for f in range(0, video_length, subvideo_length):
+                    s_f = max(0, f - pad_len)
+                    e_f = min(video_length, f + subvideo_length + pad_len)
+                    pad_len_s = max(0, f) - s_f
+                    pad_len_e = e_f - min(video_length, f + subvideo_length)
+                    
+                    sub_flow = (gt_flows_bi[0][:, s_f:e_f], gt_flows_bi[1][:, s_f:e_f])
+                    sub_mask = flow_masks[:, s_f:e_f+1]
+                    
+                    pred_sub, _ = self.fix_flow_complete.forward_bidirect_flow(sub_flow, sub_mask)
+                    pred_sub = self.fix_flow_complete.combine_flow(sub_flow, pred_sub, sub_mask)
+                    
+                    pred_flows_f.append(pred_sub[0][:, pad_len_s:e_f-s_f-pad_len_e])
+                    pred_flows_b.append(pred_sub[1][:, pad_len_s:e_f-s_f-pad_len_e])
+                    torch.cuda.empty_cache()
+                pred_flows_bi = (torch.cat(pred_flows_f, dim=1), torch.cat(pred_flows_b, dim=1))
+            else:
+                pred_flows_bi, _ = self.fix_flow_complete.forward_bidirect_flow(gt_flows_bi, flow_masks)
+                pred_flows_bi = self.fix_flow_complete.combine_flow(gt_flows_bi, pred_flows_bi, flow_masks)
+
+            # -------------------------------------------------------
+            # 4. Image Propagation
+            # -------------------------------------------------------
+            masked_frames = frames * (1 - masks_dilated)
+            sub_prop_len = min(100, subvideo_length)
+            
+            if video_length > sub_prop_len:
+                updated_frames_list, updated_masks_list = [], []
+                pad_len = 10
+                for f in range(0, video_length, sub_prop_len):
+                    s_f = max(0, f - pad_len)
+                    e_f = min(video_length, f + sub_prop_len + pad_len)
+                    pad_len_s = max(0, f) - s_f
+                    pad_len_e = e_f - min(video_length, f + sub_prop_len)
+                    
+                    b_s, t_s, _, h_s, w_s = masks_dilated[:, s_f:e_f].size()
+                    pred_flows_sub = (pred_flows_bi[0][:, s_f:e_f-1], pred_flows_bi[1][:, s_f:e_f-1])
+                    
+                    prop_imgs, updated_masks_sub = self.model.img_propagation(
+                        masked_frames[:, s_f:e_f], pred_flows_sub, masks_dilated[:, s_f:e_f], 'nearest')
+                    
+                    updated_frames_sub = frames[:, s_f:e_f] * (1 - masks_dilated[:, s_f:e_f]) + \
+                                         prop_imgs.view(b_s, t_s, 3, h_s, w_s) * masks_dilated[:, s_f:e_f]
+                    
+                    updated_frames_list.append(updated_frames_sub[:, pad_len_s:e_f-s_f-pad_len_e])
+                    updated_masks_list.append(updated_masks_sub.view(b_s, t_s, 1, h_s, w_s)[:, pad_len_s:e_f-s_f-pad_len_e])
+                    torch.cuda.empty_cache()
+                updated_frames = torch.cat(updated_frames_list, dim=1)
+                updated_masks = torch.cat(updated_masks_list, dim=1)
+            else:
+                b, t, _, h, w = masks_dilated.size()
+                prop_imgs, updated_masks = self.model.img_propagation(masked_frames, pred_flows_bi, masks_dilated, 'nearest')
+                updated_frames = frames * (1 - masks_dilated) + prop_imgs.view(b, t, 3, h, w) * masks_dilated
+                updated_masks = updated_masks.view(b, t, 1, h, w)
+
+            # -------------------------------------------------------
+            # 5. Transformer & Composition
+            # -------------------------------------------------------
+            neighbor_stride = neighbor_length // 2
+            ref_num = subvideo_length // ref_stride if video_length > subvideo_length else -1
+            
+            final_frames = [None] * video_length
+            
+            # Use Original binary mask for compositing
+            binary_masks_np = masks_dilated[0, :, 0].cpu().numpy().astype(np.uint8) # (T, H, W)
+
+            for f in range(0, video_length, neighbor_stride):
+                neighbor_ids = [i for i in range(max(0, f - neighbor_stride), min(video_length, f + neighbor_stride + 1))]
+                ref_ids = get_ref_index(f, neighbor_ids, video_length, ref_stride, ref_num)
+                
+                # Model inference
+                pred_feat = self.model(
+                    updated_frames[:, neighbor_ids + ref_ids], 
+                    (pred_flows_bi[0][:, neighbor_ids[:-1]], pred_flows_bi[1][:, neighbor_ids[:-1]]), 
+                    masks_dilated[:, neighbor_ids + ref_ids], 
+                    updated_masks[:, neighbor_ids + ref_ids], 
+                    len(neighbor_ids)
+                )
+                
+                # Process output
+                pred_feat = pred_feat.view(-1, 3, h, w)
+                pred_feat = (pred_feat + 1) / 2
+                pred_feat = pred_feat.cpu().permute(0, 2, 3, 1).numpy() * 255 # (N, H, W, 3) RGB
+
+                for i, idx in enumerate(neighbor_ids):
+                    # Original Frame (BGR)
+                    img_ori = frames_bgr[idx]
+                    
+                    # Pred Frame (RGB -> BGR)
+                    img_pred = cv2.cvtColor(np.array(pred_feat[i]).astype(np.uint8), cv2.COLOR_RGB2BGR)
+                    
+                    # Mask (0 or 1)
+                    m = binary_masks_np[idx][:, :, None]
+                    
+                    # Composite
+                    res = img_pred * m + img_ori * (1 - m)
+                    
+                    if final_frames[idx] is None:
+                        final_frames[idx] = res
+                    else:
+                        final_frames[idx] = final_frames[idx] * 0.5 + res * 0.5
+            
+            # 6. Return list of uint8 BGR arrays
+            return [f.astype(np.uint8) for f in final_frames]

+
+def estimate_3d_hand_keypoints(
+    model, # hawor model
+    frames: List[np.ndarray],
+    bboxes: List[np.ndarray],
+    hand_side: int, # 0 (left), 1 (right)
+    img_focal: float,
+) -> np.ndarray:
+
+    assert len(frames) == len(bboxes) and len(frames) > 0
+    T = len(frames)
+    h0, w0 = frames[0].shape[:2]
+    img_center = [w0 / 2.0, h0 / 2.0]
+    frame_idx = np.arange(T)
+    assert hand_side in (0,1)
+ 
+    do_flip = (hand_side == 0)
+    with torch.inference_mode():
+        # results["pred_rotmat"]: (T, 16, 3, 3)  (root + 15 joints)
+        # results["pred_trans"]:  (T, 1, 3)
+        # results["pred_shape"]:  (T, 10)
+        results = model.inference(
+            frames,
+            bboxes,
+            img_focal=img_focal,
+            img_center=img_center,
+            do_flip=do_flip
+        )
+    rotmat_all = results["pred_rotmat"][None, ...]  # (1, T, 16, 3, 3)
+    root_rotmat = rotmat_all[:, :, 0]
+    hand_rotmat = rotmat_all[:, :, 1:]
+    root_aa = rotation_matrix_to_angle_axis(root_rotmat)
+    hand_aa = rotation_matrix_to_angle_axis(hand_rotmat)
+
+    if do_flip:
+        root_aa[..., 1] *= -1
+        root_aa[..., 2] *= -1
+        hand_aa[..., 1] *= -1
+        hand_aa[..., 2] *= -1
+
+    trans = results["pred_trans"][None, :, 0]
+    betas = results["pred_shape"][None, ...]
+    if do_flip: mano_out = run_mano_left(trans, root_aa, hand_aa, betas=betas) # left
+    else: mano_out = run_mano(trans, root_aa, hand_aa, betas=betas) # right
+    joints = mano_out["joints"][0].cpu().numpy()  # (T, 21, 3)
+    vertices = mano_out["vertices"][0].cpu().numpy()  # (T, 778, 3)
+    wrist_rot_aa = root_aa[0].cpu().numpy().astype(np.float32)    # (T, 3)
+    finger_rot_aa = hand_aa[0].cpu().numpy().astype(np.float32)  # (T, 15, 3)
+    return joints, vertices, wrist_rot_aa, finger_rot_aa # camera coordinate
